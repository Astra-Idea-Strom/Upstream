# ─── Groq (Text AI: Naming, Taglines, Visual Direction) ────────────────────────
GROQ_API_KEY=gsk_...

# ─── Gemini (Image AI: Template-based Logo Generation) ─────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Fal.ai / Flux (Image AI: Scratch Logo Generation) ─────────────────────────
FAL_API_KEY=sk-...

# ─── Firebase Admin SDK ─────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
